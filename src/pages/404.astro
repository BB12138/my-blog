---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="页面不存在">
  <section class="mx-auto flex max-w-3xl flex-col items-center justify-center px-6 py-24 text-center">
    <p class="mb-4 text-7xl font-bold tracking-tight">404</p>
    <h1 class="mb-2 text-2xl font-semibold">页面不存在</h1>
    <p class="mb-8 text-neutral-500">你要找的页面可能已经被搬走，或者从未存在过。</p>
    <a
      href="/"
      class="rounded-md bg-neutral-900 px-4 py-2 text-sm text-white dark:bg-neutral-100 dark:text-neutral-900"
    >
      回到首页
    </a>
  </section>
</BaseLayout>